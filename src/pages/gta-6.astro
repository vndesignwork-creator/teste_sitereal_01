---
import Base from '../layouts/PlainBase.astro';
import MainLayout from '../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import _img_gta6_01_poster_krucmb from '../../public/uploads/gta6-01-poster.jpg';
import _img_gta6_02_launch_trailer_kb79ka from '../../public/uploads/gta6-02-launch-trailer.jpg';
import _img_gta6_03_extended_look_1u6x2jn from '../../public/uploads/gta6-03-extended-look.jpg';
import _img_gta6_04_vice_city_xojp7e from '../../public/uploads/gta6-04-vice-city.jpg';
import _img_gta6_05_screenshots_12xvjw7 from '../../public/uploads/gta6-05-screenshots.jpg';
import _img_gta6_06_media_1u21r8v from '../../public/uploads/gta6-06-media.jpg';
import _img_gta6_07_leonida_zcqdam from '../../public/uploads/gta6-07-leonida.jpg';
import _img_gta6_08_music_1str8bo from '../../public/uploads/gta6-08-music.jpg';
import _img_gta6_jason_lucia_q0uequ from '../../public/uploads/gta6-jason-lucia.jpg';
import '../styles/generated/framework.css';
import '../styles/generated/global.css';
import '../styles/generated/pages/gta-6.css';
---
<Base title="GTA 6 — Bem-vindo a Leonida" description="Página de fãs sobre Grand Theft Auto VI: data de lançamento, plataformas, Leonida, Lucia e Jason, e tudo o que se sabe do novo jogo da Rockstar Games." siteName="Teste de" lang="pt-PT">
  <Fragment slot="head">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:locale" content="pt_PT" />
    <meta name="author" content="Teste de" />
  </Fragment>
  <MainLayout>
    <section class="hero" builder-data-element="section" name="Hero">
      <Image src={_img_gta6_jason_lucia_q0uequ} widths={[480, 768, 1200, 1600, 2000]} class="hero__image" builder-data-element="image" name="Imagem do hero" alt="Jason e Lucia num descapotável de capota aberta, com o néon a refletir-se no para-brisas." sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="hero__inner" builder-data-element="div">
        <p class="hero__eyebrow" builder-data-element="text">Rockstar Games apresenta</p>
        <h1 class="hero__title" builder-data-element="heading">Grand Theft Auto VI</h1>
        <p class="hero__lead" builder-data-element="text">Bem-vindo a Leonida. Duas personagens, uma fuga e a cidade de Vice City como nunca a viu.</p>
        <div class="hero__actions" builder-data-element="div">
          <a class="btn btn--primary btn--l" builder-data-element="link" href="#historia">Descobrir a história</a>
          <a class="btn btn--white btn--outline btn--l" builder-data-element="link" href="#personagens">Conhecer Lucia e Jason</a>
        </div>
      </div>
    </section>
    <section class="facts" builder-data-element="section" name="Factos">
      <div class="facts__inner" builder-data-element="div">
        <ul class="facts__list" builder-data-element="list">
          <li class="facts__item" builder-data-element="text">
            <span class="facts__label" builder-data-element="span">Lançamento</span>
            <strong class="facts__value" builder-data-element="span">19 de novembro de 2026</strong>
          </li>
          <li class="facts__item" builder-data-element="text">
            <span class="facts__label" builder-data-element="span">Plataformas</span>
            <strong class="facts__value" builder-data-element="span">PlayStation 5 e Xbox Series X|S</strong>
          </li>
          <li class="facts__item" builder-data-element="text">
            <span class="facts__label" builder-data-element="span">Cenário</span>
            <strong class="facts__value" builder-data-element="span">Estado de Leonida</strong>
          </li>
          <li class="facts__item" builder-data-element="text">
            <span class="facts__label" builder-data-element="span">Protagonistas</span>
            <strong class="facts__value" builder-data-element="span">Lucia e Jason</strong>
          </li>
        </ul>
      </div>
    </section>
    <section class="story" builder-data-element="section" id="historia" name="História">
      <div class="story__inner" builder-data-element="div">
        <h2 class="story__title" builder-data-element="heading">Um novo capítulo em Leonida</h2>
        <p class="story__text" builder-data-element="text">Inspirado em Florida, o estado de Leonida mistura praias, pântanos, autoestradas e a luz de néon de Vice City. É o maior e mais detalhado mundo aberto que a Rockstar já criou, pensado para ser explorado a pé, de carro, de barco ou de avião.</p>
        <p class="story__text" builder-data-element="text">Quando um assalto corre mal, Lucia e Jason têm de confiar um no outro para sobreviver num submundo onde ninguém joga limpo.</p>
        <figure class="story__figure" builder-data-element="figure" name="Figura da história">
          <Image src={_img_gta6_03_extended_look_1u6x2jn} widths={[480, 768, 1200, 1600, 2000]} class="story__image" builder-data-element="image" name="Imagem da história" alt="Lucia e Jason de lenço no rosto, junto a uma bomba de gasolina ao pôr do sol, com palmeiras e um carro de porta aberta." sizes="(min-width: 80rem) 80rem, 100vw" />
        </figure>
      </div>
    </section>
    <section class="cast" builder-data-element="section" id="personagens" name="Personagens">
      <div class="cast__inner" builder-data-element="div">
        <h2 class="cast__title" builder-data-element="heading">Duas vidas, um plano</h2>
        <figure class="cast__figure" builder-data-element="figure" name="Figura das personagens">
          <Image src={_img_gta6_05_screenshots_12xvjw7} widths={[480, 768, 1200, 1600, 2000]} class="cast__image" builder-data-element="image" name="Imagem das personagens" alt="Lucia e Jason abraçados numa pista de dança iluminada a néon." sizes="(min-width: 80rem) 80rem, 100vw" />
        </figure>
        <div class="cast__grid" builder-data-element="div">
          <article class="cast__card" builder-data-element="div">
            <h3 class="cast__name" builder-data-element="heading">Lucia</h3>
            <p class="cast__role" builder-data-element="text">Determinada, impulsiva e sempre um passo à frente. Lucia sabe o que custa a liberdade e está disposta a pagar por ela.</p>
          </article>
          <article class="cast__card" builder-data-element="div">
            <h3 class="cast__name" builder-data-element="heading">Jason</h3>
            <p class="cast__role" builder-data-element="text">Leal e calculista, Jason entra no crime por necessidade e fica por causa de Lucia. Juntos formam a dupla mais perigosa do estado.</p>
          </article>
        </div>
      </div>
    </section>
    <section class="features" builder-data-element="section" name="Destaques">
      <div class="features__inner" builder-data-element="div">
        <h2 class="features__title" builder-data-element="heading">O que esperar</h2>
        <div class="features__grid" builder-data-element="div">
          <article class="features__item" builder-data-element="div">
            <Image src={_img_gta6_07_leonida_zcqdam} widths={[480, 768, 1200, 1600, 2000]} class="features__image" builder-data-element="image" name="Imagem do destaque" alt="Homem de boné e óculos de sol numa boia de flamingo cor-de-rosa numa piscina, vista de cima." sizes="(min-width: 80rem) 20rem, 50vw" />
            <h3 class="features__name" builder-data-element="heading">Mundo vivo</h3>
            <p class="features__text" builder-data-element="text">Cidadãos, trânsito e fauna que reagem ao que fazes, de dia e de noite.</p>
          </article>
          <article class="features__item" builder-data-element="div">
            <Image src={_img_gta6_02_launch_trailer_kb79ka} widths={[480, 768, 1200, 1600, 2000]} class="features__image" builder-data-element="image" name="Imagem do destaque" alt="Jason de pé e Lucia sentada no capot de um carro vermelho, a carregar armas ao pôr do sol." sizes="(min-width: 80rem) 20rem, 50vw" />
            <h3 class="features__name" builder-data-element="heading">Dois protagonistas</h3>
            <p class="features__text" builder-data-element="text">Alterna entre Lucia e Jason numa narrativa que se cruza a cada missão.</p>
          </article>
          <article class="features__item" builder-data-element="div">
            <Image src={_img_gta6_04_vice_city_xojp7e} widths={[480, 768, 1200, 1600, 2000]} class="features__image" builder-data-element="image" name="Imagem do destaque" alt="Um casal armado diante do néon do Ocean View Hotel, com um carro vermelho atrás." sizes="(min-width: 80rem) 20rem, 50vw" />
            <h3 class="features__name" builder-data-element="heading">Vice City renovada</h3>
            <p class="features__text" builder-data-element="text">Uma cidade icónica reimaginada, com bairros que têm identidade própria.</p>
          </article>
          <article class="features__item" builder-data-element="div">
            <Image src={_img_gta6_06_media_1u21r8v} widths={[480, 768, 1200, 1600, 2000]} class="features__image" builder-data-element="image" name="Imagem do destaque" alt="Lucia e Jason equipados para um assalto num cofre de banco, com notas a voar." sizes="(min-width: 80rem) 20rem, 50vw" />
            <h3 class="features__name" builder-data-element="heading">Liberdade total</h3>
            <p class="features__text" builder-data-element="text">Missões, negócios, assaltos ou apenas uma volta de carro pela costa.</p>
          </article>
        </div>
      </div>
    </section>
    <section class="gallery" builder-data-element="section" name="Galeria">
      <div class="gallery__inner" builder-data-element="div">
        <h2 class="gallery__title" builder-data-element="heading">O mundo de Leonida</h2>
        <figure class="gallery__figure" builder-data-element="figure" name="Figura da galeria">
          <Image src={_img_gta6_01_poster_krucmb} widths={[480, 768, 1200, 1600, 2000]} class="gallery__image" builder-data-element="image" name="Imagem da galeria" alt="Colagem de arte oficial do jogo com Lucia e Jason, um helicóptero, uma lancha, um carro desportivo, um crocodilo e outras personagens à volta do logótipo." sizes="(min-width: 80rem) 80rem, 100vw" />
          <figcaption class="gallery__caption" builder-data-element="text">Arte oficial de Grand Theft Auto VI, © Rockstar Games.</figcaption>
        </figure>
      </div>
    </section>
    <section class="cta" builder-data-element="section" name="Chamada final">
      <Image src={_img_gta6_08_music_1str8bo} widths={[480, 768, 1200, 1600, 2000]} class="cta__image" builder-data-element="image" name="Imagem da chamada final" alt="Ilustração de Lucia e Jason encostados a um carro, com a skyline de Vice City ao pôr do sol." sizes="100vw" />
      <div class="cta__inner" builder-data-element="div">
        <h2 class="cta__title" builder-data-element="heading">A espera está quase a acabar</h2>
        <p class="cta__text" builder-data-element="text">Prepara-te para regressar a Vice City.</p>
        <a class="btn btn--primary btn--xl" builder-data-element="link" href="#historia">Voltar ao início da história</a>
        <p class="cta__note" builder-data-element="text">Página de fãs não oficial. Grand Theft Auto é uma marca da Take-Two Interactive e da Rockstar Games.</p>
      </div>
    </section>
  </MainLayout>
</Base>
