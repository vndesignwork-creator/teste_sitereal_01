---
import Base from '../layouts/PlainBase.astro';
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/generated/framework.css';
import '../styles/generated/global.css';
import '../styles/generated/pages/teste-de-colecao.css';
import testedecolecaoEntriesData from "../data/teste-de-colecao.json";
let testedecolecaoEntries: Record<string, any>[] = testedecolecaoEntriesData;
testedecolecaoEntries = testedecolecaoEntries.slice().sort((a, b) => -1 * ((x, y) => typeof x === 'number' && typeof y === 'number' ? x - y : ((x) => x instanceof Date ? x.toISOString() : String(x ?? ''))(x).localeCompare(((x) => x instanceof Date ? x.toISOString() : String(x ?? ''))(y)))((a.data?.created ?? a.created), (b.data?.created ?? b.created)));
---
<Base title="Teste de coleção" siteName="Teste de" canonical="https://vndesignwork-creator.github.io/teste_sitereal_01/teste-de-colecao" lang="pt-PT">
  <Fragment slot="head">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:locale" content="pt_PT" />
    <meta name="author" content="Teste de" />
  </Fragment>
  <MainLayout>
    <section class="teste-de-colecao-archive" builder-data-element="section">
      <div builder-data-element="container">
        <h1 class="teste-de-colecao-archive__heading" builder-data-element="heading">Teste de coleção</h1>
        <div class="teste-de-colecao-archive__grid" builder-data-element="div">
          {testedecolecaoEntries.map((item) => (
            <article class="teste-de-colecao-archive__card" builder-data-element="div">
              <h2 class="teste-de-colecao-archive__title" builder-data-element="heading">
                <a class="teste-de-colecao-archive__link" builder-data-element="link" href={item.url}>{item.title}</a>
              </h2>
            </article>
          ))}
        </div>
      </div>
    </section>
  </MainLayout>
</Base>
