  "components": [
    {
      "id": "cmp-mwl1mr4x-1",
      "name": "Tooltip",
      "file": "own",
      "path": "src/components/starwind/tooltip/Tooltip.astro",
      "root": [
        {
          "id": "r-code-2b",
          "tag": "astro-code",
          "attrs": {
            "builder-data-element": "code",
            "data-open": "<TooltipPrimitive.Root\n  class={tooltip({ class: className })}\n  defaultOpen={defaultOpen}\n  closeDelay={closeDelay}\n  closeOnEscape={closeOnEscape}\n  closeOnOutsideInteract={closeOnOutsideInteract}\n  disabled={disabled}\n  disableHoverableContent={disableHoverableContent}\n  openDelay={openDelay}\n  {...rest}\n  data-slot=\"tooltip\"\n>",
            "data-close": "</TooltipPrimitive.Root>"
          },
          "children": [
            {
              "id": "r-slot-2a",
              "tag": "slot",
              "attrs": {
                "builder-data-element": "slot"
              },
              "children": []
            }
          ]
        }
      ],
      "frontmatter": "import TooltipPrimitive from \"@starwind-ui/astro/tooltip\";\nimport type { HTMLAttributes } from \"astro/types\";\nimport { tooltip } from \"./variants\";\n\ntype Props = HTMLAttributes<\"div\"> & {\n  defaultOpen?: boolean;\n  closeDelay?: number;\n  closeOnEscape?: boolean;\n  closeOnOutsideInteract?: boolean;\n  disabled?: boolean;\n  disableHoverableContent?: boolean;\n  openDelay?: number;\n};\n\nconst {\n  defaultOpen = false,\n  closeDelay = 200,\n  closeOnEscape = true,\n  closeOnOutsideInteract = true,\n  disabled = false,\n  disableHoverableContent = false,\n  openDelay = 200,\n  class: className,\n  ...rest\n} = Astro.props;"
    }
  ],
