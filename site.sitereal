      "id": "glob-sheet-mwkydri3-2",
      "name": "Global",
      "rules": [
        {
          "selector": ".teste-class",
          "css": "color: var(--accent-70); opacity: 0.92; display: block;"
        },
        {
          "selector": ".Contanier-class-teste",
          "css": "background: #b72626;\nblock-size: 100%;\nflex-direction: row;\njustify-content: center;\nalign-items: center;\npadding: var(--space-xl);\n\n@media (max-width: 768px) {\n\n}\n\n@media (max-width: 390px) {\n  flex-direction: column;\n}"
        },
        {
          "selector": ".texto",
          "css": "color: var(--primary-100);"
        },
        {
          "selector": ".img",
          "css": "background-image: url(\"/bolo-caseiro.jpg\");"
        },
        {
          "selector": ".titulo",
          "css": "text-decoration: underline;\nbackground: var(--white);\npadding: 10px;\nmargin: 20px;"
        },
        {
          "selector": ".hero-sec__title",
          "css": "display: block; transition: scale 200ms cubic-bezier(0.15, 1.08, 0.79, 0.44), translate 200ms cubic-bezier(0.15, 1.08, 0.79, 0.44);"
        },
        {
          "selector": ".hero-sec",
          "css": "flex-direction: row;\nbackground: var(--primary-60);\nmargin: 10px;\npadding: 20px;\nborder-radius: 20px;\nalign-self: center;"
        },
        {
          "selector": ".hero-sec__title:hover",
          "css": "translate: 0 6px; scale: 1.07;"
        },
        {
          "selector": ".cont-teste",
          "css": "padding: var(--space-m); background: #1aefe1; border-width: 1px; border-style: solid; border-radius: var(--radius-l);"
        }
      ]
    }
