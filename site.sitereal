      "seo": {
        "description": "Página de fãs sobre Grand Theft Auto VI: data de lançamento, plataformas, Leonida, Lucia e Jason, e tudo o que se sabe do novo jogo da Rockstar Games."
      },
      "stylesheets": [
        {
          "id": "sheet-mwmapxpt-1",
          "name": "Page",
          "rules": [
            {
              "selector": ".hero",
              "css": "position: relative;\nisolation: isolate;\noverflow: hidden;\nbackground: radial-gradient(circle at 85% 15%, var(--primary-60), transparent 55%), var(--base);\npadding-block: var(--section-space-xxl);\npadding-inline: var(--site-padding);\nmin-block-size: 80vh;\ndisplay: grid;\nalign-items: center;\n&::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  background: linear-gradient(90deg, var(--base-90), var(--base-30));\n}"
            },
            {
              "selector": ".hero__inner",
              "css": "position: relative; inline-size: 100%; max-inline-size: var(--content-width); margin-inline: auto; display: grid; gap: var(--container-spacing); justify-items: start;"
            },
            {
              "selector": ".hero__eyebrow",
              "css": "color: var(--primary-200); font-size: var(--text-s);"
            },
            {
              "selector": ".hero__title",
              "css": "color: var(--link-color); font-size: var(--h1);\n\n@media (max-width: 768px) {\n  color: var(--primary-200);\n  text-align: center;\n}\n\n@media (max-width: 390px) {\n  color: var(--base-300);\n}"
            },
            {
              "selector": ".hero__lead",
              "css": "color: var(--white); font-size: var(--text-xl); max-inline-size: 40ch;"
            },
            {
              "selector": ".hero__actions",
              "css": "display: flex; flex-wrap: wrap; gap: var(--space-m);"
            },
            {
              "selector": ".facts",
              "css": "background: var(--primary); padding-block: var(--section-space-s); padding-inline: var(--site-padding);"
            },
            {
              "selector": ".facts__inner",
              "css": "max-inline-size: var(--content-width); margin-inline: auto;"
            },
            {
              "selector": ".facts__list",
              "css": "display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: var(--grid-gap); list-style: none; padding: 0; margin: 0;"
            },
            {
              "selector": ".facts__item",
              "css": "display: grid; gap: var(--space-xxs);"
            },
            {
              "selector": ".facts__label",
              "css": "color: var(--white); font-size: var(--text-s);"
            },
            {
              "selector": ".facts__value",
              "css": "color: var(--white); font-size: var(--text-l);"
            },
            {
              "selector": ".story",
              "css": "padding-block: var(--section-space-l); padding-inline: var(--site-padding);"
            },
            {
              "selector": ".story__inner",
              "css": "max-inline-size: var(--content-width); margin-inline: auto; display: grid; gap: var(--container-spacing);"
            },
            {
              "selector": ".story__title",
              "css": "font-size: var(--h2);"
            },
            {
              "selector": ".story__text",
              "css": "font-size: var(--text-l); max-inline-size: 65ch;"
            },
            {
              "selector": ".cast",
              "css": "background: var(--base); padding-block: var(--section-space-l); padding-inline: var(--site-padding);"
            },
            {
              "selector": ".cast__inner",
              "css": "max-inline-size: var(--content-width); margin-inline: auto; display: grid; gap: var(--container-spacing);"
            },
            {
              "selector": ".cast__title",
              "css": "color: var(--white); font-size: var(--h2);"
            },
            {
              "selector": ".cast__grid",
              "css": "display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: var(--grid-gap);"
            },
            {
              "selector": ".cast__card",
              "css": "display: grid;\ngap: var(--content-spacing);\npadding: var(--space-l);\nborder: var(--border-width) solid var(--primary);\nborder-radius: var(--radius-l);\nbackground: var(--base-20);\ntransition: translate var(--motion-duration) var(--motion-ease), background-color var(--motion-duration) var(--motion-ease);\n&:hover {\n  background: var(--white-20);\n}\n@media (prefers-reduced-motion: no-preference) {\n  &:hover {\n    translate: 0 calc(-1 * var(--space-xs));\n  }\n}"
            },
            {
              "selector": ".cast__name",
              "css": "color: var(--primary-200); font-size: var(--h3);"
            },
            {
              "selector": ".cast__role",
              "css": "color: var(--white);"
            },
            {
              "selector": ".features",
              "css": "padding-block: var(--section-space-l); padding-inline: var(--site-padding);"
            },
            {
              "selector": ".features__inner",
              "css": "max-inline-size: var(--content-width); margin-inline: auto; display: grid; gap: var(--container-spacing);"
            },
            {
              "selector": ".features__title",
              "css": "font-size: var(--h2);"
            },
            {
              "selector": ".features__grid",
              "css": "display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: var(--grid-gap);"
            },
            {
              "selector": ".features__item",
              "css": "display: grid; gap: var(--space-s); padding: var(--space-l); border: var(--border); border-radius: var(--radius-m); box-shadow: var(--shadow-s); align-content: start; transition: translate var(--motion-duration) var(--motion-ease), box-shadow var(--motion-duration) var(--motion-ease), border-color var(--motion-duration) var(--motion-ease); &:hover { border-color: var(--primary); box-shadow: var(--shadow-l); } @media (prefers-reduced-motion: no-preference) { &:hover { translate: 0 calc(-1 * var(--space-xs)); } }"
            },
            {
              "selector": ".features__name",
              "css": "font-size: var(--h4);"
            },
            {
              "selector": ".features__text",
              "css": ""
            },
            {
              "selector": ".cta",
              "css": "position: relative; isolation: isolate; overflow: hidden; background: var(--base); padding-block: var(--section-space-xl); padding-inline: var(--site-padding); text-align: center; &::after { content: \"\"; position: absolute; inset: 0; z-index: -1; background: var(--base-70); }"
            },
            {
              "selector": ".cta__inner",
              "css": "position: relative; max-inline-size: var(--content-width-inset); margin-inline: auto; display: grid; gap: var(--container-spacing); justify-items: center;"
            },
            {
              "selector": ".cta__title",
              "css": "color: var(--white); font-size: var(--h1);"
            },
            {
              "selector": ".cta__text",
              "css": "color: var(--white); font-size: var(--text-l);"
            },
            {
              "selector": ".cta__note",
              "css": "color: var(--white); font-size: var(--text-xs);"
            },
            {
              "selector": ".hero__image",
              "css": "position: absolute; inset-inline: 0; inset-block: -10%; z-index: -2; inline-size: 100%; block-size: 120%; object-fit: cover; object-position: 70% center;"
            },
            {
              "selector": ".story__figure",
              "css": "margin: 0;"
            },
            {
              "selector": ".story__image",
              "css": "display: block; inline-size: 100%; aspect-ratio: 21 / 9; object-fit: cover; border-radius: var(--radius-l); box-shadow: var(--shadow-m);"
            },
            {
              "selector": ".cast__figure",
              "css": "margin: 0;"
            },
            {
              "selector": ".cast__image",
              "css": "display: block; inline-size: 100%; aspect-ratio: 21 / 9; object-fit: cover; object-position: center 30%; border-radius: var(--radius-l);"
            },
            {
              "selector": ".features__image",
              "css": "display: block; inline-size: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-s);"
            },
            {
              "selector": ".gallery",
              "css": "padding-block: var(--section-space-l); padding-inline: var(--site-padding);"
            },
            {
              "selector": ".gallery__inner",
              "css": "max-inline-size: var(--content-width); margin-inline: auto; display: grid; gap: var(--container-spacing);"
            },
            {
              "selector": ".gallery__title",
              "css": "font-size: var(--h2);"
            },
            {
              "selector": ".gallery__figure",
              "css": "margin: 0; display: grid; gap: var(--space-s);"
            },
            {
              "selector": ".gallery__image",
              "css": "display: block; inline-size: 100%; block-size: auto; border-radius: var(--radius-l); box-shadow: var(--shadow-m);"
            },
            {
              "selector": ".gallery__caption",
              "css": "font-size: var(--text-xs);"
            },
            {
              "selector": ".cta__image",
              "css": "position: absolute; inset-inline: 0; inset-block: -10%; z-index: -2; inline-size: 100%; block-size: 120%; object-fit: cover; object-position: center;"
            }
          ]
        }
      ]
    },
